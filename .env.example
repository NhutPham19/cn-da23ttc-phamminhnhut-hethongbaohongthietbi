NODE_ENV=development
PORT=7000

# Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Ứng dụng chạy: pooler Supabase cổng 6543 (cấu hình connection_limit=5 & pool_timeout=15 để chống nghẽn hàng đợi khi có nhiều yêu cầu đồng thời)
DATABASE_URL="postgresql://<nguoi_dung>:<mat_khau>@<host-pooler>:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=15"

# Lệnh prisma migrate / db push: kết nối trực tiếp, hoặc pooler chế độ session cổng 5432 nếu mạng không có IPv6
DIRECT_URL="postgresql://<nguoi_dung>:<mat_khau>@<host>:5432/postgres"

# ZALO BOT PLATFORM
ZALO_BOT_TOKEN="your_zalo_bot_token_here"
ZALO_SECRET_TOKEN="your_zalo_secret_token_here"

# CLOUDINARY
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name_here"
CLOUDINARY_API_KEY="your_cloudinary_api_key_here"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret_here"

# GMAIL SMTP (Gửi mã OTP khôi phục mật khẩu - dùng cho Localhost)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your_email@gmail.com"
EMAIL_PASS="your_16_char_google_app_password"

# DỊCH VỤ GỬI EMAIL QUA HTTP API (Khuyên dùng khi deploy lên Render Free Tier vì Render chặn cổng SMTP 25, 465, 587)
# 1. Brevo API (Khuyên dùng: Miễn phí 300 email/ngày, không cần tên miền riêng, dùng được email Gmail cá nhân):
BREVO_API_KEY="xkeysib-your_brevo_api_key_here"
# 2. Hoặc Resend API:
# RESEND_API_KEY="re_your_resend_api_key_here"
# 3. Hiển thị mã OTP trên giao diện khi kiểm thử (tùy chọn: true/false):
ALLOW_OTP_DEV_DISPLAY="true"
